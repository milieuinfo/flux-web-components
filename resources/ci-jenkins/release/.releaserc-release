{
    "branches": [
        "release-v2",
        { name: 'release-v2-2.4', range: '2.4.x', channel: '2.4.x' }
    ],
    "plugins": [
        [
            "@semantic-release/commit-analyzer",
            {
                "preset": "conventionalcommits",
                "releaseRules": [
                    { "type": "docs", "release": "patch" }
                ]
            }
        ],
        [
            "@semantic-release/release-notes-generator",
            {
                "preset": "conventionalcommits",
                "presetConfig": {
                    "types": [
                        { "type": "fix", "section": "Bug Fixes" },
                        { "type": "feat", "section": "Features" },
                        { "type": "docs", "section": "Documentation" }
                    ]
                },
                # de conventionalcommits preset rendert elke versie-heading als '##', waardoor een minor release er in
                # de Storybook changelog uitziet als een patch release; deze headerPartial herstelt het gedrag van de
                # standaard (angular) preset: '#' voor major/minor en '##' voor patch releases
                "writerOpts": {
                    "headerPartial": "{{#if isPatch}}##{{else}}#{{/if}} {{#if @root.linkCompare}}[{{version}}]({{@root.host}}/{{@root.owner}}/{{@root.repository}}/compare/{{previousTag}}...{{currentTag}}){{else}}{{version}}{{/if}}{{#if title}} \"{{title}}\"{{/if}}{{#if date}} ({{date}}){{/if}}\n"
                }
            }
        ],
        [
            "@semantic-release/changelog",
            {
                "changelogFile": "resources/changelog/CHANGELOG.md"
            }
        ],
        [
            "@semantic-release/npm",
            {
                "npmPublish": false
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets":
                [
                    "resources/changelog/CHANGELOG.md",
                    "package.json",
                    "libs/components/src/atom/atom.web-types.json",
                    "libs/components/src/block/block.web-types.json",
                    "libs/components/src/compliance/compliance.web-types.json",
                    "libs/components/src/form/form.web-types.json",
                    "libs/map/map.web-types.json"
                ],
                "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
            }
        ],
        [
            "@semantic-release/github"
        ]
    ]
}
